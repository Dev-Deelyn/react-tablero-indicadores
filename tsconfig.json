{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl" : ".",
    "paths": {
      "styled-components/*": ["src/styled-components/*"],
      "config/*": ["src/config/*"],
      "pages/*": ["src/pages/*"],
      "containers/*": ["src/containers/*"],
      "router/*": ["src/router/*"],
      "components/*": ["src/components/*"],
      "assets/*": ["src/assets/*"],
      "helpers/*": ["src/helpers/*"],
      "hooks/*": ["src/hooks/*"],
      "contexts/*": ["src/contexts/*"],
      "types/*": ["src/types/*"],
      "utils/*": ["src/utils/*"],
    }
  }
}
