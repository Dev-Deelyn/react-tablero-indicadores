{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "styled-components/*": ["./src/styled-components/*"],
      "config/*": ["./src/config/*"],
      "pages/*": ["./src/pages/*"],
      "containers/*": ["./src/containers/*"],
      "router/*": ["./src/router/*"],
      "components/*": ["./src/components/*"],
      "assets/*": ["./src/assets/*"],
      "helpers/*": ["./src/helpers/*"],
      "hooks/*": ["./src/hooks/*"],
      "contexts/*": ["./src/contexts/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
    }
  },
  "include": ["vite.config.ts", "src", "types"]
}